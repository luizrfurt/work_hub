APP_ENV=development

DATABASE_URL=postgresql+psycopg://workhub:workhub@localhost:5432/workhub

JWT_SECRET_KEY=change-me

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIRECTORY=./uploads
STORAGE_QUOTA_GB=10

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Comma-separated origins are allowed, e.g. http://localhost:5173,http://192.168.0.10:5173
FRONTEND_URL=http://localhost:5173

# Produção (VPS): o compose da raiz sobrescreve DATABASE_URL e FRONTEND_URL.
# FRONTEND_URL=https://workhub.zioncor.com.br
# DATABASE_URL=postgresql+psycopg://workhub:workhub@workhub-db:5432/workhub
# UPLOAD_DIRECTORY=/app/uploads
# STORAGE_QUOTA_GB=10

